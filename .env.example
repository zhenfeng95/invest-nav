# Public site origin used for canonical URLs, Open Graph, sitemap and robots.txt.
# Local development:
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Production example:
# NUXT_PUBLIC_SITE_URL=https://invest-nav.example.workers.dev

# Closing reports from a separate GitHub repository.
# Path is the directory that contains weekday markdown files, e.g. reports or daily.
NUXT_GITHUB_REPORTS_OWNER=
NUXT_GITHUB_REPORTS_REPO=
NUXT_GITHUB_REPORTS_PATH=output/daily
NUXT_GITHUB_REPORTS_REF=main
NUXT_GITHUB_TRADES_PATH=data/raw/trades

# Required for private repos. Recommended for public repos to avoid GitHub rate limits.
# Create a fine-grained token with Contents: Read access to that repository.
NUXT_GITHUB_TOKEN=
